<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- active: light red + bright red bottom bar -->
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFCDD2" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#E57373" />
                </shape>
            </item>
            <item
                android:gravity="bottom"
                android:height="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F44336" />
                    <corners
                        android:bottomLeftRadius="6dp"
                        android:bottomRightRadius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- idle: gray + blue bottom bar -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_surface" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/md_theme_outline" />
                </shape>
            </item>
            <item
                android:gravity="bottom"
                android:height="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2196F3" />
                    <corners
                        android:bottomLeftRadius="6dp"
                        android:bottomRightRadius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>