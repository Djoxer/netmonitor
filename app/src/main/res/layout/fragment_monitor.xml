<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/md_theme_background">

    <!-- Icon toolbar: Start | Stop | Clear | Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Start"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_start" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Stop"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_stop" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Clear"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_clear" />

        <ImageButton
            android:id="@+id/btnBlockMode"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Global block mode"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_block"
            android:alpha="0.4" />
    </LinearLayout>

    <!-- Terminal / console -->
    <TextView
        android:id="@+id/terminalText"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#000000"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:textColor="#00FF00"
        android:textSize="11sp"
        android:typeface="monospace"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:lineSpacingMultiplier="1"
        android:gravity="top|start"
        android:textIsSelectable="true"
        android:text="+--------------------------------------------+\n| boot sequence complete                      |\n+--------------------------------------------+\nnetmonitor@device:~$ " />

    <!-- Placeholder for 24h chart (next step) -->
    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginBottom="8dp"
        android:background="@color/md_theme_surface"
        android:visibility="gone">

        <dev.djoxer.netmonitor.ui.TrafficChartView
            android:id="@+id/trafficChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="24h traffic"
            android:textColor="@color/md_theme_on_surface_variant"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- IPv4 / IPv6 labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/labelIpv4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IPv4 (0B)"
            android:textColor="@color/bar_ipv4"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/labelIpv6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0B) IPv6"
            android:textColor="@color/bar_ipv6"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Fused IP share bar -->
    <LinearLayout
        android:id="@+id/barIpMix"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:orientation="horizontal"
        android:background="@color/md_theme_outline"
        android:layout_marginBottom="8dp">

        <View
            android:id="@+id/barPartV4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/bar_ipv4" />

        <View
            android:id="@+id/barPartV6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@color/bar_ipv6" />
    </LinearLayout>

    <!-- App filter -->
    <EditText
        android:id="@+id/appSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Filter apps…"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/md_theme_on_surface"
        android:textColorHint="@color/md_theme_on_surface_variant"
        android:background="@color/md_theme_surface"
        android:padding="10dp"
        android:layout_marginBottom="6dp" />

    <!-- Out / In columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↑ Outgoing"
                android:textColor="@color/bar_ipv6"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:textAlignment="center"
                android:paddingBottom="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerOut"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↓ Incoming"
                android:textColor="@color/bar_ipv4"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:textAlignment="center"
                android:paddingBottom="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerIn"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>