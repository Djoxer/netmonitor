<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/md_theme_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/detailIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/detailPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_on_surface_variant"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Out / In / Bypass in one row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <ToggleButton
            android:id="@+id/switchBlockOut"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:textOn="Out"
            android:textOff="Out"
            android:textSize="11sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_toggle_direction"
            android:textColor="@color/toggle_direction_text"
            android:button="@null" />

        <ToggleButton
            android:id="@+id/switchBlockIn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:textOn="In"
            android:textOff="In"
            android:textSize="11sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_toggle_direction"
            android:textColor="@color/toggle_direction_text"
            android:button="@null" />

        <ToggleButton
            android:id="@+id/switchAllow"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:textOn="Allow"
            android:textOff="Allow"
            android:textSize="11sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_toggle_bypass"
            android:textColor="@color/toggle_bypass_text"
            android:button="@null" />

        <ToggleButton
            android:id="@+id/switchBypass"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:textOn="Bypass"
            android:textOff="Bypass"
            android:textSize="11sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_toggle_bypass"
            android:textColor="@color/toggle_bypass_text"
            android:button="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/profileModeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/md_theme_on_surface_variant"
        android:textSize="11sp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Schedules (active = blocked both ways)"
        android:textColor="@color/status_running"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSchedules"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/md_theme_background" />

    <Button
        android:id="@+id/btnAddSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add schedule"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connections"
        android:textColor="@color/bar_ipv4"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/md_theme_background"
        android:fillViewport="true">

        <TextView
            android:id="@+id/detailConnections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="@color/md_theme_on_surface_variant"
            android:textSize="12sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close"
        android:layout_marginTop="8dp" />
</LinearLayout>