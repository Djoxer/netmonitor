<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear event log" />

        <Button
            android:id="@+id/btnDeleteOldLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete logs older than 7 days" />

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export log as CSV" />

        <Button
            android:id="@+id/btnExportJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export log as JSON" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blocking"
            android:textColor="#FF5722"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnClearPermanentBlocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear all permanent blocks" />

        <Button
            android:id="@+id/btnClearSchedules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear all schedules" />

        <Button
            android:id="@+id/btnReloadRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reload rules from database" />

        <TextView
            android:id="@+id/settingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:paddingTop="16dp" />
    </LinearLayout>
</ScrollView>