<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@color/profile_dropdown_bg">

    <TextView
            android:id="@+id/profileSpinnerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/md_theme_on_surface"
            android:maxLines="1"
            android:ellipsize="end" />

    <ImageView
            android:id="@+id/profileSpinnerCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_profile_check"
            android:visibility="gone"
            android:contentDescription="@null" />

    <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_spinner_arrow"
            android:contentDescription="@null" />
</LinearLayout>